# Network the app uses: testnet (Arc Testnet, Base Sepolia; default) or mainnet
NEXT_PUBLIC_ARDOISE_NETWORK=testnet
# Arc RPC endpoint; optional, defaults to the public Arc RPC. In the app it must match NEXT_PUBLIC_ARDOISE_NETWORK
# (chain id 5042 on mainnet, 5042002 on testnet); the keeper still follows mainnet only
ARC_RPC_URL=
# Private key of the dedicated deployer / demo wallet (never a personal wallet)
DEPLOYER_PRIVATE_KEY=
# Private key of the keeper wallet. It only calls the public sweep() on Ardoise accounts and needs a little
# USDC on Arc for gas. Leave empty for a dry run that logs decisions without sending anything
KEEPER_PRIVATE_KEY=
# Address of the Ardoise factory on Arc mainnet (see contracts/deployments.md). While it is empty the keeper
# explains that nothing is deployed yet and exits
ARDOISE_FACTORY_ADDRESS=
# Block the factory was deployed at, so the keeper finds accounts created before it started. Optional: when
# empty, the keeper only watches accounts created after it starts
ARDOISE_FACTORY_DEPLOY_BLOCK=
# Base RPC endpoint, to check deliveries on the payee's chain
BASE_RPC_URL=
# Circle client key for Modular Wallets (passkeys), if available on Arc mainnet
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
# Circle client URL for Modular Wallets
NEXT_PUBLIC_CIRCLE_CLIENT_URL=
# Circle API key for Gateway / attestation calls (server side only)
CIRCLE_API_KEY=
