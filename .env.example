# Network the app uses: testnet (Arc Testnet, Base Sepolia; default) or mainnet
NEXT_PUBLIC_ARDOISE_NETWORK=testnet
# Arc RPC endpoint; optional, defaults to the public Arc RPCs (Blockdaemon's first, the others as fallbacks). In the app it must match NEXT_PUBLIC_ARDOISE_NETWORK
# (chain id 5042 on mainnet, 5042002 on testnet); the keeper still follows mainnet only
ARC_RPC_URL=
# Private key of the dedicated deployer / demo wallet (never a personal wallet)
DEPLOYER_PRIVATE_KEY=
# Guard deployment (contracts/script/DeployGuard.s.sol): minimum and target health factors in WAD. Optional,
# default 1250000000000000000 (1.25) and 1500000000000000000 (1.5)
ARDOISE_MIN_HEALTH_FACTOR=
ARDOISE_TARGET_HEALTH_FACTOR=
# Set to true only to replace a guard that is already set on the factory. Leave empty otherwise
ARDOISE_REPLACE_GUARD=
# Default caps of new Ardoise accounts, used by contracts/script/Deploy.s.sol, in USDC units (6 decimals).
# Optional: default 10000000 (10 USDC) per payment and 20000000 (20 USDC) per UTC day
ARDOISE_PER_PAYMENT_CAP=
ARDOISE_DAILY_CAP=
# CCTP finality threshold given to new accounts by the deploy script. Optional: default 2000 (standard),
# which Circle documents for Arc as a source
ARDOISE_MIN_FINALITY_THRESHOLD=
# Private key of the keeper wallet. It only calls the public sweep() on Ardoise accounts and needs a little
# USDC on Arc for gas. Leave empty for a dry run that logs decisions without sending anything
KEEPER_PRIVATE_KEY=
# Address of the Ardoise factory on Arc mainnet (see contracts/deployments.md). While it is empty the keeper
# explains that nothing is deployed yet and exits
ARDOISE_FACTORY_ADDRESS=
# Block the factory was deployed at, so the keeper finds accounts created before it started. Optional: when
# empty, the keeper only watches accounts created after it starts
ARDOISE_FACTORY_DEPLOY_BLOCK=
# JSON file of Gateway standing orders (signed burn intents to each owner's Ardoise account), read by the keeper on
# every pass. Optional: when empty, the keeper never draws from Gateway. Keep it outside the repository. In a dry run
# (no KEEPER_PRIVATE_KEY) the keeper only logs the orders it would submit
GATEWAY_ORDERS_FILE=
# Port of the keeper's standing-order intake, where the app sends the orders users sign. Optional: needs
# GATEWAY_ORDERS_FILE; listens on 127.0.0.1 only. Each order is checked on chain before it is stored
GATEWAY_INTAKE_PORT=
# Browser origin allowed to call the intake (the app). Defaults to http://localhost:3000
APP_ORIGIN=
# URL of the keeper's order intake as the browser reaches it, for example http://localhost:8787. Public (no secret);
# when empty, the app's Protection panel cannot send standing orders
NEXT_PUBLIC_KEEPER_URL=
# Base RPC endpoint: the app checks deliveries on the payee's chain, the keeper verifies standing-order signatures.
# Optional, defaults to the public Base RPC
BASE_RPC_URL=
# Circle client key for Modular Wallets (passkeys). Public by design (a client key, not an API key), restricted in the
# Circle Console to the app's passkey domain. When empty, the app offers browser wallets only
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
# Circle client URL for Modular Wallets. Optional, defaults to https://modular-sdk.circle.com/v1/rpc/w3s/buidl
NEXT_PUBLIC_CIRCLE_CLIENT_URL=
# Circle API key for Gateway / attestation calls (server side only)
CIRCLE_API_KEY=
