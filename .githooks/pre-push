#!/bin/sh
# Blocks direct pushes to main or master: changes reach them only through
# reviewed pull requests. Creating main for the first time is allowed.
# Installed by pointing git at this folder: git config core.hooksPath .githooks

zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$remote_sha" != "$zero" ]; then
        echo "pre-push: direct pushes to ${remote_ref#refs/heads/} are not allowed." >&2
        echo "  Push your branch and open a pull request: git push -u origin HEAD && gh pr create" >&2
        exit 1
      fi ;;
  esac
done
exit 0
