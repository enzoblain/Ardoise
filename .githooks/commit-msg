#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits.
# Installed by pointing git at this folder: git config core.hooksPath .githooks

msg_file="$1"
subject=$(sed -n '/^[^#]/{p;q;}' "$msg_file")

# Commits carry their human author only: no co-author trailers and no
# "generated by" lines from AI coding tools. Checked first, so git's own
# messages (fixup!, squash!, merges) cannot carry them either.
# Ignore the diff `git commit -v` appends below the scissors line.
body=$(sed '/^# -\{24\} >8 -\{24\}$/,$d' "$msg_file" | grep -v '^#')
if printf '%s\n' "$body" | grep -Eiq '^[[:space:]]*co-authored-by:'; then
  echo "commit-msg: remove the Co-Authored-By trailer; commits list their author only." >&2
  exit 1
fi
if printf '%s\n' "$body" | grep -Eiq '^[^a-z]*generated (with|by).*(claude|anthropic)|@anthropic\.com'; then
  echo "commit-msg: remove the AI \"generated with\" line; commit messages describe the change only." >&2
  exit 1
fi

# Let git's own generated messages through.
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9._/-]+\))?!?: [^A-Z].*[^.]$"

fail() {
  echo "commit-msg: $1" >&2
  echo "  got: $subject" >&2
  echo "  expected: <type>(<optional scope>): <subject>" >&2
  echo "  types: $(echo "$types" | tr '|' ' ')" >&2
  echo "  example: feat(api): add settlement retry on expired nonce" >&2
  exit 1
}

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  fail "the first line must follow Conventional Commits (lowercase subject, no trailing period)."
fi

if [ "${#subject}" -gt 72 ]; then
  fail "the first line is ${#subject} characters long; keep it to 72 or fewer."
fi

if [ -n "$(sed -n '2p' "$msg_file" | grep -v '^#')" ]; then
  fail "leave a blank line between the subject and the body."
fi

exit 0
